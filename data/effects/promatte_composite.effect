// Final composition: decontaminated foreground over the selected background.
// Output uses straight (non-premultiplied) alpha as OBS filters expect.
uniform float4x4 ViewProj;
uniform texture2d image;      // full-resolution source
uniform texture2d alphaTex;   // refined alpha (r), bilinear alpha (g)
uniform texture2d matteTex;   // low-res RGBA: rgb = model foreground colour (if any)
uniform texture2d bgEstimate; // inpainted / blurred background estimate (rgb, a = confidence)
uniform texture2d background; // replacement image / video / source
uniform float2 bgUvScale;     // background fit mapping
uniform float2 bgUvOffset;
uniform float  bgClampOutside; // 1 = transparent outside [0,1] (contain), 0 = clamp

uniform int    mode;          // 0 transparent, 1 colour, 2 image/video/source, 3 blur, 4 dim
uniform float4 color;         // straight RGBA
uniform float  colorOpacity;
uniform float  dimBrightness;
uniform float  dimOpacity;
uniform float  decontaminate; // 0..1
uniform float  haloRemoval;   // 0..1
uniform float  hasForeground; // 1 when matteTex.rgb is a model foreground prediction
uniform int    debugView;     // 0 none, 1 matte, 2 edges, 3 confidence, 4 foreground, 5 raw matte

sampler_state linearSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};
sampler_state borderSampler {
	Filter    = Linear;
	AddressU  = Border;
	AddressV  = Border;
	BorderColor = 00000000;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float3 heat(float t)
{
	// blue -> cyan -> green -> yellow -> red
	float3 c = saturate(float3(1.5 - abs(4.0 * t - 3.0), 1.5 - abs(4.0 * t - 2.0), 1.5 - abs(4.0 * t - 1.0)));
	return c;
}

float4 PSComposite(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float4 src = image.Sample(linearSampler, uv);
	float2 ab = alphaTex.Sample(linearSampler, uv).rg;
	float a = saturate(ab.r);
	float4 est = bgEstimate.Sample(linearSampler, uv);
	float3 bgEst = lerp(src.rgb, est.rgb, est.a);

	// --- edge decontamination -------------------------------------------
	float edge = 4.0 * a * (1.0 - a);        // 1 in the middle of the transition band
	float3 fg = src.rgb;
	if (hasForeground > 0.5) {
		float3 modelFg = matteTex.Sample(linearSampler, uv).rgb;
		fg = lerp(fg, modelFg, decontaminate * edge);
	} else {
		// matting equation: src = a * fg + (1 - a) * bg  =>  fg = (src - (1 - a) * bg) / a
		float3 unmixed = saturate((src.rgb - (1.0 - a) * bgEst) / max(a, 0.05));
		fg = lerp(fg, unmixed, decontaminate * edge);
	}

	// --- halo removal ----------------------------------------------------
	// Semi-transparent pixels whose colour matches the estimated background are
	// background fringe: pull their alpha down.
	float sim = 1.0 - saturate(length(src.rgb - bgEst) / 0.22);
	float band = 1.0 - smoothstep(0.55, 0.95, a);
	a *= 1.0 - haloRemoval * sim * band * est.a;

	// --- debug views -----------------------------------------------------
	if (debugView == 1)
		return float4(a, a, a, 1.0);
	if (debugView == 2) {
		float band2 = smoothstep(0.02, 0.15, a) * (1.0 - smoothstep(0.85, 0.98, a));
		float3 base = src.rgb * 0.35;
		return float4(lerp(base, float3(1.0, 0.1, 0.1), band2), 1.0);
	}
	if (debugView == 3)
		return float4(heat(ab.g), 1.0);
	if (debugView == 4)
		return float4(fg * a, 1.0);
	if (debugView == 5) {
		// Raw model matte, upsampled bilinearly - bypasses every refinement pass.
		float raw = matteTex.Sample(linearSampler, uv).a;
		return float4(raw, raw, raw, 1.0);
	}

	// --- composition -----------------------------------------------------
	float srcA = src.a;
	if (mode == 0) {
		return float4(fg, a * srcA);
	}
	float3 bg;
	float bgA;
	if (mode == 1) {
		bg = color.rgb;
		bgA = colorOpacity;
	} else if (mode == 2) {
		float2 buv = uv * bgUvScale + bgUvOffset;
		float4 b = (bgClampOutside > 0.5) ? background.Sample(borderSampler, buv)
						  : background.Sample(linearSampler, buv);
		bg = b.rgb;
		bgA = b.a;
	} else if (mode == 3) {
		bg = bgEst;
		bgA = srcA;
	} else {
		bg = src.rgb * dimBrightness;
		bgA = dimOpacity * srcA;
	}
	float outA = a * srcA + (1.0 - a * srcA) * bgA;
	float3 rgb = (fg * a * srcA + bg * bgA * (1.0 - a * srcA)) / max(outA, 1e-4);
	return float4(rgb, outA);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSComposite(v_in);
	}
}
